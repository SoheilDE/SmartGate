{
  "features": {
    "semantic_cache": true,
    "model_routing": true,
    "fallback": true
  },
  "routing": {
    "complexity_threshold": 0.6,
    "cache_similarity_threshold": 0.92,
    "keyword_routing": [],
    "intent_routing": {
      "conversational": "fast",
      "factual": "fast",
      "creative": "fast",
      "math": "powerful",
      "analytical": "powerful",
      "code": "powerful"
    }
  },
  "models": {
    "fast": {
      "model": "gpt-3.5-turbo",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "FAST_MODEL_API_KEY"
    },
    "powerful": {
      "model": "gpt-4",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "POWERFUL_MODEL_API_KEY"
    }
  }
}
