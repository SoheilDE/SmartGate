# ── Fast tier (low-complexity prompts) ──────────────────────────────────────
FAST_MODEL=gpt-3.5-turbo
FAST_MODEL_BASE_URL=https://api.openai.com/v1
FAST_MODEL_API_KEY=sk-...

# ── Powerful tier (high-complexity prompts + fallback) ───────────────────────
POWERFUL_MODEL=gpt-4
POWERFUL_MODEL_BASE_URL=https://api.openai.com/v1
POWERFUL_MODEL_API_KEY=sk-...

# ── Custom model API keys ─────────────────────────────────────────────────────
# Add one env var per provider. Reference the var name in config.json models section.
# These are only needed if you define custom model tiers in config.json.
#
# Examples:
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Routing ──────────────────────────────────────────────────────────────────
# Prompts scored >= this threshold are routed to the powerful model (0.0–1.0)
COMPLEXITY_THRESHOLD=0.6

# ── Semantic cache ───────────────────────────────────────────────────────────
# Cosine similarity >= this value is treated as a cache hit (0.0–1.0)
CACHE_SIMILARITY_THRESHOLD=0.92
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=smartgate_cache

# ── Admin ────────────────────────────────────────────────────────────────────
# Secret key required to access /admin/* endpoints
ADMIN_API_KEY=change-me-to-a-strong-secret

# ── Gateway config ───────────────────────────────────────────────────────────
# Path to the admin-editable JSON config file
GATEWAY_CONFIG_PATH=config.json

# ── Telemetry ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smartgate:smartgate@localhost:5432/smartgate
